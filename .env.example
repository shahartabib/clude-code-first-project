# AI Learning Methods - Environment Configuration Example
# Copy this file to .env.local and fill in your actual values

# API Configuration
VITE_API_ENDPOINT=http://localhost:3001/api
VITE_API_TIMEOUT=30000

# LLM Provider Configuration
# Choose one of the following based on your preferred provider

# Anthropic Claude
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
VITE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI GPT
VITE_OPENAI_API_KEY=sk-xxxxxxxxxxxxx
VITE_OPENAI_MODEL=gpt-4

# Google Gemini
VITE_GOOGLE_API_KEY=xxxxxxxxxxxxx
VITE_GOOGLE_MODEL=gemini-pro

# Application Settings
VITE_APP_NAME=AI Learning Methods
VITE_ARTICLES_PER_PAGE=12
VITE_ENABLE_SEARCH=true
VITE_ENABLE_SUMMARIES=true
VITE_ENABLE_CATEGORIES=true

# Analytics (optional)
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ID=

# Feature Flags
VITE_FEATURE_RECOMMENDATIONS=false
VITE_FEATURE_EXPORT_PDF=false
VITE_FEATURE_USER_ACCOUNTS=false
VITE_FEATURE_SHARING=false
